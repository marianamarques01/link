{
  "name": "link-comunicacao-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gh-pages": "tsc --noEmit && GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "preview:gh-pages": "npm run build:gh-pages && vite preview",
    "deploy:pages": "npm run build:gh-pages && cp dist/index.html dist/404.html && npx gh-pages -d dist -t"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
